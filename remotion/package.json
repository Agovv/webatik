{
    "name": "maestro-remotion",
    "version": "0.1.0",
    "description": "Remotion demo video for the Maestro SaaS boilerplate landing page.",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "remotion studio",
        "build:video": "remotion render src/index.ts MaestroDemo ../public/video/maestro-demo.mp4",
        "build:poster": "remotion still src/index.ts MaestroDemo ../public/video/maestro-demo-poster.png --frame=120"
    },
    "dependencies": {
        "@remotion/cli": "4.0.290",
        "motion": "^12.42.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "remotion": "4.0.290"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/web": "^0.0.200",
        "typescript": "^5.9.3"
    }
}
